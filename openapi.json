  "components": {
    "schemas": {
      "Bindings": {
        "properties": {
          "flight_a": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Flight A"
          },
          "flight_b": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Flight B"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "Bindings"
      },
      "CsvRow": {
        "properties": {
          "row": {
            "type": "integer",
            "title": "Row"
          }
        },
        "type": "object",
        "required": [
          "row"
        ],
        "title": "CsvRow"
      },
      "Disruption": {
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "runway_closure",
              "taxi_closure",
              "gate_closure",
              "latest",
              "emergency",
              "reset_emergency",
              "turbulence",
              "reset_turbulence",
              "delay"
            ],
            "title": "Kind"
          },
          "start": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Start",
            "default": 0
          },
          "end": {
            "type": "integer",
            "minimum": 1.0,
            "title": "End",
            "default": 1
          },
          "flight_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Flight Id"
          },
          "gate": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Gate"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "kind"
        ],
        "title": "Disruption"
      },
      "Flight": {
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 60,
            "minLength": 1,
            "title": "Id"
          },
          "ready": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Ready"
          },
          "latest": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Latest"
          },
          "scheduled_departure": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Scheduled Departure"
          },
          "turnaround": {
            "type": "integer",
            "minimum": 60.0,
            "title": "Turnaround",
            "default": 2100
          },
          "taxi": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Taxi",
            "default": 300
          },
          "taxi_out": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Taxi Out"
          },
          "wake": {
            "type": "string",
            "enum": [
              "SUPER",
              "HEAVY",
              "LARGE",
              "SMALL"
            ],
            "title": "Wake",
            "default": "LARGE"
          },
          "contingency": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Contingency",
            "default": 0
          },
          "duty_end": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Duty End"
          },
          "enroute_absorb": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Enroute Absorb",
            "default": 0
          },
          "gates": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "minItems": 1,
            "title": "Gates"
          },
          "preferred_gate": {
            "type": "string",
            "title": "Preferred Gate"
          },
          "connections": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Connections",
            "default": 0
          },
          "connection_deadline": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Connection Deadline",
            "default": 100000
          },
          "emergency": {
            "type": "boolean",
            "title": "Emergency",
            "default": false
          },
          "motion_event": {
            "type": "boolean",
            "title": "Motion Event",
            "default": false
          },
          "note": {
            "type": "string",
            "maxLength": 1200,
            "title": "Note",
            "default": ""
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "ready",
          "latest",
          "scheduled_departure",
          "gates",
          "preferred_gate"
        ],
        "title": "Flight"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HardwareEvent": {
        "properties": {
          "flight_id": {
            "type": "string",
            "title": "Flight Id"
          },
          "event": {
            "type": "string",
            "enum": [
              "EMERGENCY",
              "DISRUPTION",
              "CLEAR"
